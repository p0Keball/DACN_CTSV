# Mẫu cấu hình Backend — copy thành `.env` rồi điền giá trị thật. Không commit `.env`.
PORT=5000
# Supabase pooler, ví dụ: postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# API key DLU Proxy (header X-API-KEY), ví dụ: mk_dev_...
DLU_API_KEY=
# Khóa ký JWT đăng nhập admin (Gói 7) — chuỗi ngẫu nhiên dài, không chia sẻ
JWT_SECRET=
# eOffice (§3, luồng B): mock = dữ liệu mẫu nội bộ, http = service clone/thật
EOFFICE_PROVIDER=http
EOFFICE_BASE_URL=https://api-eoffice.nguyentronghieu.io.vn
# AI soạn email từ file (Phase 1): key Gemini chỉ ở backend, không commit
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# SMTP Gmail gửi mail thật: bật "Mật khẩu ứng dụng" cho Gmail khoa rồi điền vào đây
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Cron nhắc hạn (mặc định 30 phút); MAIL_DRY_RUN=true = chỉ log, không gửi (để test)
REMIND_CRON=*/30 * * * *
MAIL_DRY_RUN=
